# Examples only. Node does not automatically load this file.
# For local use, run pnpm start without environment variables; it generates .data/local-access.txt.
# Production: set these in your deployment platform, not in committed source code.
NODE_ENV=production
PORT=10000
QIDU_DATA_DIR=/var/data/qidu/library
APP_ORIGIN=https://replace-with-your-real-domain.example
QIDU_ACCESS_PASSWORD=REPLACE_WITH_YOUR_OWN_UNIQUE_12_TO_256_CHARACTER_PASSWORD
